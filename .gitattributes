# Auto detect text files and perform LF normalization
* text=auto

# Java / Maven
*.java text diff=java
*.xml text
*.properties text eol=lf

# Shell scripts
*.sh text eol=lf
# Maven wrapper：容器内直接执行，Windows 检出必须保持 LF（#479）
mvnw text eol=lf
# mvnw 用 `while IFS= read -r` 逐行读取这两个文件并拼进 MAVEN_OPTS；read -r 只去掉
# \n 不去掉 \r，CRLF 检出会把 `-Xmx2g\r` 原样传给 java（Invalid maximum heap size）。
# 与 mvnw 同理，必须锁定 LF。
.mvn/jvm.config text eol=lf
.mvn/maven.config text eol=lf

# Windows batch
*.bat text eol=crlf
*.cmd text eol=crlf

# Web
*.html text
*.css text
*.js text
*.ts text
*.vue text
*.json text
*.yaml text
*.yml text
*.svg text

# Binary
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Signed catalog payloads must be byte-identical on every checkout: the
# Ed25519 signature (provider-catalog.sig) covers the exact manifest bytes,
# so line-ending normalization would break verification on CRLF checkouts.
backend/provider-adapters/src/main/resources/catalog/* -text
