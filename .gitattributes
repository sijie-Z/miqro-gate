# Auto detect text files and perform LF normalization
* text=auto

# Java / Maven
*.java text diff=java
*.xml text
*.properties text eol=lf

# Shell scripts
*.sh text eol=lf
# Maven wrapper：容器内直接执行，Windows 检出必须保持 LF（#479）
mvnw text eol=lf

# Windows batch
*.bat text eol=crlf
*.cmd text eol=crlf

# Web
*.html text
*.css text
*.js text
*.ts text
*.vue text
*.json text
*.yaml text
*.yml text
*.svg text

# Markdown may legitimately sit in the object store as CRLF: `docs/progress.md`
# is (5020 CR bytes at 3385e4dd, appended to on every Goal). Without this,
# `git diff --check` counts the CR of every added line as trailing whitespace,
# so a docs-only PR that appends to progress.md reports ~92 violations and the
# CI gate (#895) looks broken the moment it is armed. `cr-at-eol` exempts only
# the CR: a real trailing space and a leftover conflict marker still fail
# (verified — see _orchestrate/reports/PH10_report.md §4).
*.md whitespace=cr-at-eol

# Binary
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Signed catalog payloads must be byte-identical on every checkout: the
# Ed25519 signature (provider-catalog.sig) covers the exact manifest bytes,
# so line-ending normalization would break verification on CRLF checkouts.
backend/provider-adapters/src/main/resources/catalog/* -text
