# Auto detect text files and perform LF normalization
* text=auto

# Java / Maven
*.java text diff=java
*.xml text
*.properties text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows batch
*.bat text eol=crlf
*.cmd text eol=crlf

# Web
*.html text
*.css text
*.js text
*.ts text
*.vue text
*.json text
*.yaml text
*.yml text
*.svg text

# Binary
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Signed catalog payloads must be byte-identical on every checkout: the
# Ed25519 signature (provider-catalog.sig) covers the exact manifest bytes,
# so line-ending normalization would break verification on CRLF checkouts.
backend/provider-adapters/src/main/resources/catalog/* -text
