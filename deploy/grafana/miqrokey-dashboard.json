      "targets": [{ "expr": "sum(rate(miqrokey_gateway_requests_total[5m])) by (status_class)", "legendFormat": "{{status_class}}", "refId": "A" }],
      "title": "Gateway requests by status class (5m rate)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
