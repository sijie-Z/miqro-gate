# MiQroKey production stack (deploy/compose.prod.yaml) — copy to deploy/.env.
# NEVER commit the real .env; it stays on the server only.

# Public URLs — REQUIRED, replace with your domain (must match the TLS cert).
MIQROKEY_PUBLIC_BASE_URL=https://miqrokey.example.com
MIQROKEY_GATEWAY_BASE_URL=https://miqrokey.example.com
# Browser origins accepted in production mode: 必须是无路径的 https 裸 origin
# （ProductionStartupValidator 逐项校验，解析失败会拒绝启动）。
MIQROKEY_ORIGIN_ALLOWLIST=https://miqrokey.example.com

# Postgres (service-internal; the password comes from secrets/db_password).
POSTGRES_DB=miqrokey
POSTGRES_USER=miqrokey

# Tag for the locally built application images.
MIQROKEY_IMAGE_TAG=local

# Recommended for internet-facing deployments: invite-only (no self-signup).
MIQROKEY_REGISTRATION_ENABLED=false

# Optional admin-surface hardening: restrict the portal to these source IPs
# (comma-separated CIDRs). X-Forwarded-For is only honored from the compose
# network (MIQROKEY_CONTROL_ADMIN_TRUSTED_PROXIES default below).
# MIQROKEY_CONTROL_ADMIN_IP_ALLOWLIST=203.0.113.0/24
MIQROKEY_CONTROL_ADMIN_TRUSTED_PROXIES=172.28.0.0/24

# Backup schedule timezone and failure notifications (WeCom/Feishu bot webhook).
TZ=Asia/Shanghai
# MIQROKEY_BACKUP_WEBHOOK_URL=
# MIQROKEY_BACKUP_WEBHOOK_SECRET=

# ── 站点级功能开关：**取值一律写在本文件** ────────────────────────────────
# compose.prod.yaml 用 ${VAR:-默认} 把下面这些值透传进容器，所以放在这里就够了；
# 直接手改运行树的 compose.prod.yaml 会怎样：值对 git 不可见、下次整树同步就丢，
# 而且 `deploy.sh` 每次部署都会就两份 compose 的差异打 WARNING（§9）并记进部署流水。
#
# 响应缓存（L1+L2，默认关；按 Key 显式开启后才可能命中）。
# MIQROKEY_CACHE_ENABLED=true
# 留痕查看器内置消费端（默认关；打开需同时给 broker 地址）。
# MIQROKEY_RETENTION_CONSUMER_ENABLED=true
# MIQROKEY_RETENTION_CONSUMER_BOOTSTRAP_SERVERS=redpanda:9092
# 派生列调和定时通道（默认关；只重算标签与补缺失金额，不动既有金额）。
# MIQROKEY_USAGE_PRICE_RECONCILE_ENABLED=true
# 留痕 Kafka 出口（ADR-0014 R3，默认关；留痕开关本身也是租户级默认关）。
# 自托管：先 `docker compose -f compose.prod.yaml --profile kafka up -d` 起内置 Redpanda
# （用下面的 COMPOSE_PROFILES 免带 --profile），再取消注释并 `up -d gateway`；
# 腾讯云 CKafka：直接填其接入地址（不需要 profile）。
# MIQROKEY_RETENTION_KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
# COMPOSE_PROFILES=kafka
