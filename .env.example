# MiQroKey Gateway — Environment Configuration
# Copy to .env and fill in values for local development.
# .env MUST NOT be committed.

# PostgreSQL
POSTGRES_DB=miqrokey
POSTGRES_USER=miqrokey
POSTGRES_PASSWORD=change-me-in-production

# Application
MIQROKEY_ENVIRONMENT=development
MIQROKEY_GATEWAY_PORT=8081
MIQROKEY_CONTROL_PORT=8080

# Database (used by control-plane-app)
MIQROKEY_DB_URL=jdbc:postgresql://localhost:5432/miqrokey
MIQROKEY_DB_USERNAME=miqrokey
# MIQROKEY_DB_PASSWORD_FILE=/run/secrets/db_password

# Encryption (generate with: openssl rand -hex 32)
# MIQROKEY_MASTER_KEY_FILE=/run/secrets/master_key
# MIQROKEY_VK_HMAC_KEY_FILE=/run/secrets/vk_hmac_key

# Bootstrap admin (only used for first admin creation, remove after)
# MIQROKEY_BOOTSTRAP_SECRET_FILE=/run/secrets/bootstrap_secret

# Session
# MIQROKEY_SESSION_COOKIE_NAME=MIQROKEY_SESSION

# Webhook
# MIQROKEY_WEBHOOK_ENABLED=true
