root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yaml,yml}]
indent_size = 2

[*.{json,md,xml,css,html,js,ts,vue}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.properties]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
