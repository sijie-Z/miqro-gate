<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.miqroera.miqrokey</groupId>
        <artifactId>miqro-key-gateway</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>test-support</artifactId>
    <packaging>jar</packaging>

    <name>MiQroKey Test Support</name>
    <description>Shared test fixtures, mock providers, and contract test utilities</description>

    <dependencies>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.miqroera.miqrokey</groupId>
            <artifactId>domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.miqroera.miqrokey</groupId>
            <artifactId>provider-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>com.miqroera.miqrokey</groupId>
            <artifactId>route-snapshot</artifactId>
        </dependency>

        <!-- reactor-netty for mock provider (test scope in consumers) -->
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty-http</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>

        <!-- Testing libraries (compile scope so consumers inherit them) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>compatibility</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <artifactSet>
                                <excludes>
                                    <!-- Test-only libraries must not appear in the standalone compatibility jar -->
                                    <exclude>org.assertj:assertj-core</exclude>
                                    <exclude>org.junit.jupiter:junit-jupiter-api</exclude>
                                    <exclude>org.junit.platform:*</exclude>
                                    <exclude>org.opentest4j:*</exclude>
                                    <exclude>org.apiguardian:*</exclude>
                                    <exclude>net.bytebuddy:*</exclude>
                                </excludes>
                            </artifactSet>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.miqroera.miqrokey.testing.compatibility.CompatibilityMockServerMain</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"></transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
