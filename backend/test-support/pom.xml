        </dependency>
        <dependency>
            <groupId>com.miqroera.miqrokey</groupId>
            <artifactId>provider-spi</artifactId>
        </dependency>

        <!-- reactor-netty for mock provider (test scope in consumers) -->
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty-http</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>

        <!-- Testing libraries (compile scope so consumers inherit them) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
