<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.miqroera.miqrokey</groupId>
        <artifactId>miqro-key-gateway</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>route-snapshot</artifactId>
    <packaging>jar</packaging>

    <name>MiQroKey Route Snapshot</name>
    <description>Versioned read-only routing snapshot: keys, label bindings, credentials, and models for the gateway hot path</description>

    <dependencies>

        <!-- Jackson for jsonb product catalog columns -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.miqroera.miqrokey</groupId>
            <artifactId>domain</artifactId>
        </dependency>
        <!--
            Reuses the CryptoConfig @AutoConfiguration (KeyEncryptionProvider +
            VirtualKeyCrypto + FileSecretProvider) and EncryptedSecret for
            per-request credential decryption. Persistence repositories are NOT
            component-scanned in the gateway runtime.
        -->
        <dependency>
            <groupId>com.miqroera.miqrokey</groupId>
            <artifactId>persistence-postgres</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
