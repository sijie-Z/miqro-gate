<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.miqroera.miqrokey</groupId>
    <artifactId>miqro-key-gateway</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>MiQroKey Gateway</name>
    <description>Internal credential governance gateway for multi-vendor AI API management</description>

    <modules>
        <module>domain</module>
        <module>provider-spi</module>
        <module>provider-adapters</module>
        <module>persistence-postgres</module>
        <module>route-snapshot</module>
        <module>cache-spi</module>
        <module>queue-spi</module>
        <module>control-plane-app</module>
        <module>gateway-app</module>
        <module>test-support</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Framework versions managed by Spring Boot BOM -->
        <spring-boot.version>4.1.1</spring-boot.version>
        <!-- OpenAPI 3.1 generation (F09, api-contract §8) -->
        <springdoc.version>3.1.1</springdoc.version>

        <!-- Test dependency versions -->
        <archunit.version>1.5.0</archunit.version>
        <testcontainers.version>1.21.4</testcontainers.version>

        <!-- Plugin versions (locked for reproducible builds) -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-enforcer.version>3.5.0</maven-enforcer.version>
        <spotless.version>2.44.1</spotless.version>
        <flatten.version>1.6.0</flatten.version>
        <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM（含 testcontainers-bom 1.20.6 管理）；
                 1.21.4 覆盖见各模块的显式版本声明 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.miqroera.miqrokey</groupId>
                <artifactId>cache-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.miqroera.miqrokey</groupId>
                <artifactId>control-plane-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.miqroera.miqrokey</groupId>
                <artifactId>domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.miqroera.miqrokey</groupId>
                <artifactId>gateway-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.miqroera.miqrokey</groupId>
                <artifactId>persistence-postgres</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.miqroera.miqrokey</groupId>
                <artifactId>provider-adapters</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.miqroera.miqrokey</groupId>
                <artifactId>provider-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.miqroera.miqrokey</groupId>
                <artifactId>queue-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.miqroera.miqrokey</groupId>
                <artifactId>route-snapshot</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.miqroera.miqrokey</groupId>
                <artifactId>test-support</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!--
                Convergence pin: caffeine and the postgresql driver declare
                different checker-qual versions; pick the newer one.
            -->
            <dependency>
                <groupId>org.checkerframework</groupId>
                <artifactId>checker-qual</artifactId>
                <version>3.48.3</version>
            </dependency>

            <!--
                Patch pin (PH25, 2026-09-19): the Spring Boot 3.4.5 BOM
                manages the driver at 42.7.5, which carries three HIGH
                advisories — channel-binding fallback CVE-2025-49146,
                silent channel-binding downgrade CVE-2026-54291 (both fixed
                within 42.7.x) and the SCRAM PBKDF2-iteration client DoS
                CVE-2026-42198. Stay on the 42.7.x patch line: no API change.
                Drop this pin once the Boot BOM manages >= 42.7.12.
            -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.12</version>
            </dependency>

            <!-- External test dependencies not managed by Spring Boot BOM -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>21</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                    <configuration>
                        <archive>
                            <manifestEntries>
                                <Implementation-Title>${project.name}</Implementation-Title>
                                <Implementation-Version>${project.version}</Implementation-Version>
                                <Implementation-Vendor>MiQroEra</Implementation-Vendor>
                            </manifestEntries>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                        <!-- The integration suite legitimately needs ~70 Spring contexts
                             to wind down at JVM exit (each with its own netty graceful
                             shutdown + Hikari close). Measured on CI: 68-69 of those
                             shutdowns in passing runs and 73 in the one that got killed
                             — same order, so the default 30s exit budget sits inside the
                             suite's normal variance and turns a slow runner into a red
                             build with every test green (#985). 120s keeps the guard
                             against a genuinely hung JVM while giving the wind-down the
                             room it actually needs. -->
                        <forkedProcessExitTimeoutInSeconds>120</forkedProcessExitTimeoutInSeconds>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <configuration>
                        <!-- 瘦 jar 保留为主制品：gateway 以 test 依赖消费 control-plane-app 的模块产物
                             （ArchUnit/契约测试）。fat jar 是 BOOT-INF 布局，会让 sibling 类在测试类路径上
                             不可加载（spring.factories 仍可见→ClassNotFoundException）。可执行 jar 输出为
                             *-exec.jar，供 deploy/docker/*.Dockerfile 使用。 -->
                        <classifier>exec</classifier>
                    </configuration>
                    <executions>
                        <!-- Executable fat jars for the two deployable apps (#479):
                             declared here once; only the app modules declare this plugin. -->
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>

            <!-- Code formatting -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <eclipse>
                            <file>${maven.multiModuleProjectDirectory}/spotless.xml</file>
                        </eclipse>
                        <removeUnusedImports></removeUnusedImports>
                        <trimTrailingWhitespace></trimTrailingWhitespace>
                        <endWithNewline></endWithNewline>
                    </java>
                    <pom>
                        <sortPom>
                            <nrOfIndentSpace>4</nrOfIndentSpace>
                            <sortDependencies>scope,groupId,artifactId</sortDependencies>
                            <sortPlugins>groupId,artifactId</sortPlugins>
                        </sortPom>
                    </pom>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Enforce Java version, dependency convergence, and banned dependencies -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer.version}</version>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,4)</version>
                                </requireMavenVersion>
                                <dependencyConvergence></dependencyConvergence>
                                <banDuplicatePomDependencyVersions></banDuplicatePomDependencyVersions>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Flatten POM for consumption -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                        <phase>process-resources</phase>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <phase>clean</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
