<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.miqroera.miqrokey</groupId>
        <artifactId>miqro-key-gateway</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>queue-spi</artifactId>
    <packaging>jar</packaging>

    <name>MiQroKey Usage Queue SPI</name>
    <description>Bounded usage event bus with idempotent batch persistence and in-process request coalescing</description>

    <dependencies>
        <!-- Jackson for jsonb serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- cache-spi supplies CachedResponse, the coalescer's shared payload -->
        <dependency>
            <groupId>com.miqroera.miqrokey</groupId>
            <artifactId>cache-spi</artifactId>
        </dependency>

        <dependency>
            <groupId>com.miqroera.miqrokey</groupId>
            <artifactId>domain</artifactId>
        </dependency>

        <!-- Reactor for the coalescer's shared Mono -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- Spring Boot JDBC starter: autoconfigure, context, spring-jdbc, HikariCP (writer; DataSource supplied by gateway-app) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Testing only -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
