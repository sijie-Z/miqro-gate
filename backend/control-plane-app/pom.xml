<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.miqroera.miqrokey</groupId>
        <artifactId>miqro-key-gateway</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>control-plane-app</artifactId>
    <packaging>jar</packaging>

    <name>MiQroKey Control Plane</name>
    <description>Spring MVC management API — synchronous, plain JDBC, no reactive stack</description>

    <dependencies>
        <dependency>
            <groupId>com.miqroera.miqrokey</groupId>
            <artifactId>domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.miqroera.miqrokey</groupId>
            <artifactId>persistence-postgres</artifactId>
        </dependency>
        <dependency>
            <groupId>com.miqroera.miqrokey</groupId>
            <artifactId>provider-adapters</artifactId>
        </dependency>
        <dependency>
            <groupId>com.miqroera.miqrokey</groupId>
            <artifactId>provider-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Reactor Netty HTTP client (client transport only — no WebFlux
             runtime, ADR-0006 stands; version managed by the Boot BOM): the
             provider client transport (#507), same client stack as the gateway.
             Unlike the JDK HttpClient it keeps the Host header on the validated
             hostname while pinning the connection address — upstream WAFs 418
             IP-literal Host headers. -->
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty-http</artifactId>
        </dependency>

        <!-- Kafka client for the optional built-in retention-log consumer
             (ADR-0014 §8; version managed by the Spring Boot BOM) -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
        </dependency>
        <!-- OpenAPI 3.1 generation (F09, api-contract §8): /v3/api-docs without the
             swagger-ui bundle — the spec is the machine-readable contract source. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Boot 4 分期（#1088 Stage A）：官方 Jackson 2 过渡模块（deprecated stop-gap）。
             本 app 多处注入 com.fasterxml 的 ObjectMapper bean；Stage B 迁 Jackson 3 后移除。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Boot Web MVC (no WebFlux per ADR-0006) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>9.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test-only: verify the route snapshot loader picks up keys created
             through the management API (tag-routing closed loop). -->
        <dependency>
            <groupId>com.miqroera.miqrokey</groupId>
            <artifactId>route-snapshot</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testing -->
        <!-- Boot 4 测试面拆分（#1088 Stage A）：@AutoConfigureTestRestTemplate 需要
             spring-boot-resttestclient + spring-boot-restclient（迁移指南明列） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 测试面拆分（#1088 Stage A）：AutoConfigureTestDatabase 迁到 spring-boot-jdbc-test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 测试面拆分（#1088 Stage A）：@AutoConfigureMockMvc / TestRestTemplate 迁到
             spring-boot-webmvc-test（含 spring-boot-resttestclient） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers for PostgreSQL integration tests -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- testcontainers 核心显式版本：Boot BOM 管理 1.20.6（import 上下文求值，
             属性覆盖无效），核心版本必须与 junit-jupiter/postgresql 对齐 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>integration</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludedGroups combine.self="override"/>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
